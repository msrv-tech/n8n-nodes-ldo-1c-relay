 КонецЦикла;
 Данные = Состояние.fixture;
 Для Индекс = 0 По 1 Цикл
  Тип = ?(Индекс = 0, Данные.documentType, Данные.catalogType); Ид = ?(Индекс = 0, Данные.document, Данные.catalog);
