{
	"name": "n8n-nodes-ldo-1c-relay",
	"version": "0.2.0",
	"description": "Connect 1C to n8n using your own queue, direct HTTP, or an enrolled MSRV service",
	"license": "MIT",
	"homepage": "https://github.com/msrv-tech/n8n-nodes-ldo-1c-relay",
	"keywords": [
		"n8n-community-node-package",
		"1c",
		"ldo",
		"relay"
	],
	"author": {
		"name": "MSRV Tech",
		"email": "a@manzhela.ru"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/msrv-tech/n8n-nodes-ldo-1c-relay.git"
	},
	"scripts": {
		"build": "n8n-node build && node scripts/copy-metadata.cjs",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "npm run check",
		"test": "node test/nodes.test.cjs && node test/standalone.test.cjs",
		"check": "npm run lint && npm run build && npm test"
	},
	"files": [
		"dist",
		"docs",
		"examples"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/LdoRelayApi.credentials.js",
			"dist/credentials/Ldo1cApi.credentials.js",
			"dist/credentials/Ldo1cQueueApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Ldo1cRelay/Ldo1cRelay.node.js",
			"dist/nodes/Ldo1cQueueTrigger/Ldo1cQueueTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.51.5",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2",
		"@types/node": "^22.0.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"bugs": {
		"url": "https://github.com/msrv-tech/n8n-nodes-ldo-1c-relay/issues"
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
