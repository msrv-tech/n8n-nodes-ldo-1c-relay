						"index": 0
					}
				]
			]
		},
		"Wait for 1C": {
			"main": [
				[
					{
						"node": "Get result",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Get result": {
			"main": [
				[
					{
						"node": "Still pending",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Still pending": {
			"main": [
				[
					{
						"node": "Wait for 1C",
						"type": "main",
						"index": 0
					}
				],
				[]
			]
		}
